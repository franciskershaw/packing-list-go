# Environment files - contain sensitive data and are not needed in the image
.env
.env.local
.env.*.local

# Docker files - not needed inside the image
Dockerfile
.dockerignore

# Git and version control files
.git
.gitignore

# Docs - not needed at runtime
docs
LESSONS.md
README.md
requests

# Local IDE/editor configurations
.vscode
.idea
*.swp

# OS generated files
.DS_Store
