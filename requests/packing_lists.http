# Packing List API — Packing List Creation & Management
#
# SETUP (do this once before running any request):
#
#   1. Start the server:  go run main.go
#   2. Generate a token:  go run scripts/gen_token.go
#
# Token and host resolve automatically from .env — see requests/README.md
# for how that works. No variables to paste in this file.
#
# Recommended order: run the requests top-to-bottom.
# This file duplicates its own template + item + category setup (mirroring
# how template_items.http duplicates setup rather than depending on other
# .http files) — send the setup section first, then everything else
# references the captured IDs.
#
# From "PATCH /lists/:id/items/:itemId" onward, sections chain off
# createListWithEventDate and the two Setup items (createItem,
# createItemTwo) rather than each spinning up their own fresh
# category/item/list — one continuous story (attach → patch → remove →
# bulk-add → pack-all → unpack-all) instead of five isolated fixtures.
# Only the small amount of setup a section genuinely needs beyond what
# already exists earlier in the file (e.g. attaching the second item) is
# added inline.
#
# Setup names include {{$guid}} so re-running this file never collides with
# a previous run's leftover template/category/item (both have a per-user
# uniqueness check — a stale same-named row from an incomplete prior run
# would 409 on creation, which then cascades into a 400 on the item create
# since categoryId would resolve to an error body instead of an id).


# ══════════════════════════════════════════
#  Setup — a template with one item attached, a second item for later
#  sections, to seed a list from
# ══════════════════════════════════════════

### create the template a list will be seeded from
# @name createTemplate
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Packing List Test — Template {{$guid}}"
}

###

### create the category the seed items live in
# @name createCategory
POST http://localhost:{{$dotenv PORT}}/categories
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Packing List Test — Category {{$guid}}"
}

###

### create the seed item
# @name createItem
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Packing List Test — Item {{$guid}}",
  "categoryId": "{{createCategory.response.body.id}}"
}

###

### create a second item in the same category — used by the item-removal
#  and bulk-add sections further down
# @name createItemTwo
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Packing List Test — Item Two {{$guid}}",
  "categoryId": "{{createCategory.response.body.id}}"
}

###

### attach the first item to the template
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "{{createItem.response.body.id}}",
  "quantity": 2,
  "notes": "pack spares"
}


