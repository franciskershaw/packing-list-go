###

### ✅ 204 — remove the item from the list
DELETE {{host}}/lists/{{removeItemSetupList.response.body.id}}/items/{{removeItemSetupItem.response.body.id}}
Authorization: Bearer {{token}}

###

### ❌ 404 — removing it again (already gone) now correctly 404s
DELETE {{host}}/lists/{{removeItemSetupList.response.body.id}}/items/{{removeItemSetupItem.response.body.id}}
Authorization: Bearer {{token}}

###

### cleanup — archive this section's list
DELETE {{host}}/lists/{{removeItemSetupList.response.body.id}}
Authorization: Bearer {{token}}

###

### cleanup — delete this section's item (already off the list, so this
#            works even though ItemIsInUse would otherwise block it)
DELETE {{host}}/items/{{removeItemSetupItem.response.body.id}}
Authorization: Bearer {{token}}

###

### cleanup — delete this section's category
DELETE {{host}}/categories/{{removeItemSetupCategory.response.body.id}}
Authorization: Bearer {{token}}


# ══════════════════════════════════════════
#  POST /lists/:id/items/bulk
# ══════════════════════════════════════════
#
#  👉 NEW IN THIS COMMIT — self-contained: run just this section (its own
#  setup and cleanup below), no earlier sections needed.

### setup — a category with two items, to exercise "some already on the list"
# @name bulkSetupCategory
POST {{host}}/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Bulk Add Test — Category {{$guid}}"
}

###

### setup — first item (added to the list directly, below — bulk-add
#          should skip it)
# @name bulkSetupItemA
POST {{host}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Bulk Add Test — Item A {{$guid}}",
  "categoryId": "{{bulkSetupCategory.response.body.id}}"
}

###

### setup — second item (not yet on the list — bulk-add should add it)
# @name bulkSetupItemB
POST {{host}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Bulk Add Test — Item B {{$guid}}",
  "categoryId": "{{bulkSetupCategory.response.body.id}}"
}

###

### setup — a list
# @name bulkSetupList
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Bulk Add Test — List {{$guid}}"
}

###

### setup — add item A directly, so it's already on the list before bulk-add runs
POST {{host}}/lists/{{bulkSetupList.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemId": "{{bulkSetupItemA.response.body.id}}"
}

###

### ✅ 201 — bulk-add the category: item A skipped (already on the list),
#          only item B appears in the response
POST {{host}}/lists/{{bulkSetupList.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "categoryId": "{{bulkSetupCategory.response.body.id}}"
}

###

### ✅ 201 — running it again now returns [] (both items already on the list)
POST {{host}}/lists/{{bulkSetupList.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "categoryId": "{{bulkSetupCategory.response.body.id}}"
}

###

### ❌ 400 — missing categoryId
POST {{host}}/lists/{{bulkSetupList.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{token}}

{}

###

### ❌ 400 — invalid categoryId (not a UUID)
POST {{host}}/lists/{{bulkSetupList.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "categoryId": "not-a-uuid"
}

###

### ❌ 400 — categoryId does not exist / not accessible
POST {{host}}/lists/{{bulkSetupList.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

###

### ❌ 404 — list does not exist
POST {{host}}/lists/00000000-0000-0000-0000-000000000000/items/bulk
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "categoryId": "{{bulkSetupCategory.response.body.id}}"
}

###

### ❌ 400 — invalid list id
POST {{host}}/lists/not-a-uuid/items/bulk
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "categoryId": "{{bulkSetupCategory.response.body.id}}"
}

###

### 🔒 401 — no token
POST {{host}}/lists/{{bulkSetupList.response.body.id}}/items/bulk
Content-Type: application/json

{
  "categoryId": "{{bulkSetupCategory.response.body.id}}"
}

###

### cleanup — archive this section's list
