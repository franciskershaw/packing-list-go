# Packing List API — Packing List Creation & Management
#
# SETUP (do this once before running any request):
#
#   1. Start the server:       go run main.go
#   2. Generate a token:       go run scripts/gen_token.go
#   3. Paste the output below into @token
#
# Recommended order: run the requests top-to-bottom.
# This file duplicates its own template + item + category setup (mirroring
# how template_items.http duplicates setup rather than depending on other
# .http files) — send the setup section first, then everything else
# references the captured IDs.

@host  = http://localhost:8080
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImRldi10ZXN0QGtpdHRlZC1hcGkuaW50ZXJuYWwiLCJ1c2VySWQiOiIwMDAwMDAwMC0wMDAwLTAwMDAtMDAwMC0wMDAwMDAwMDAwMDEiLCJleHAiOjE3ODM2MjU5NTgsImlhdCI6MTc4MzYyNTA1OH0.TFrRuv004OmvxaeSIKuv6q3eTiwhL4nbgGCRX_YW6tA


# ══════════════════════════════════════════
#  Setup — a template with one item attached, to seed a list from
# ══════════════════════════════════════════

### create the template a list will be seeded from
# @name createTemplate
POST {{host}}/templates
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Packing List Test — Template"
}

###

### create the category the seed item lives in
# @name createCategory
POST {{host}}/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Packing List Test — Category"
}

###

### create the seed item
# @name createItem
POST {{host}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Packing List Test — Item",
  "categoryId": "{{createCategory.response.body.id}}"
}

###

### attach the item to the template
POST {{host}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemId": "{{createItem.response.body.id}}",
  "quantity": 2,
  "notes": "pack spares"
}


# ══════════════════════════════════════════
#  POST /lists
# ══════════════════════════════════════════

### ✅ 201 — name only, no eventDate/templateId — items: []
# @name createListNameOnly
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Weekend Hiking"
}

###

### ✅ 201 — name + eventDate
# @name createListWithEventDate
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Beach Trip",
  "eventDate": "2026-08-01"
}

###

### ✅ 201 — templateId seeds the list's items from the template
# @name createListFromTemplate
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Seeded From Template",
  "templateId": "{{createTemplate.response.body.id}}"
}

###

### ❌ 400 — missing name
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "eventDate": "2026-08-01"
}

###

### ❌ 400 — empty name
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": ""
}

###

### ❌ 400 — name exceeds 100 characters
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX"
}

###

### ❌ 400 — invalid eventDate format
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Bad Date List",
  "eventDate": "08-01-2026"
}

###

### ❌ 400 — invalid templateId (not a UUID)
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Bad Template List",
  "templateId": "not-a-uuid"
}

###

### ❌ 400 — templateId does not exist / not owned by caller
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Missing Template List",
  "templateId": "00000000-0000-0000-0000-000000000000"
}

###

### 🔒 401 — no token
POST {{host}}/lists
Content-Type: application/json

{
  "name": "Should Fail"
}


# ══════════════════════════════════════════
#  GET /lists
# ══════════════════════════════════════════

### ✅ 200 — active lists: createListNameOnly, createListWithEventDate,
#          createListFromTemplate, ordered most-recently-updated first
GET {{host}}/lists
Authorization: Bearer {{token}}

###

### ✅ 200 — archived lists (empty until the DELETE section below archives one)
GET {{host}}/lists?archived=true
Authorization: Bearer {{token}}

###

### ✅ 200 — garbage archived value behaves like the default (active-only)
GET {{host}}/lists?archived=banana
Authorization: Bearer {{token}}

###

### 🔒 401 — no token
GET {{host}}/lists


# ══════════════════════════════════════════
#  GET /lists/:id
# ══════════════════════════════════════════

### ✅ 200 — grouped by category: one category ("Packing List Test —
#          Category") containing createItem, quantity 2, notes "pack spares"
GET {{host}}/lists/{{createListFromTemplate.response.body.id}}
Authorization: Bearer {{token}}

###

### ❌ 400 — invalid id
GET {{host}}/lists/not-a-uuid
Authorization: Bearer {{token}}

###

### ❌ 404 — does not exist
GET {{host}}/lists/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

### 🔒 401 — no token
GET {{host}}/lists/{{createListFromTemplate.response.body.id}}


# ══════════════════════════════════════════
#  PATCH /lists/:id
# ══════════════════════════════════════════

### ✅ 200 — rename only
PATCH {{host}}/lists/{{createListNameOnly.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Weekend Hiking (renamed)"
}

###

### ✅ 200 — eventDate only
PATCH {{host}}/lists/{{createListNameOnly.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "eventDate": "2026-09-01"
}

###

### ❌ 400 — neither name nor eventDate present
PATCH {{host}}/lists/{{createListNameOnly.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{}

###

### ❌ 400 — invalid eventDate format
PATCH {{host}}/lists/{{createListNameOnly.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "eventDate": "09-01-2026"
}

###

### ❌ 404 — does not exist
PATCH {{host}}/lists/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Should Fail"
}

###

### ❌ 400 — invalid id
PATCH {{host}}/lists/not-a-uuid
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Should Fail"
}

###

### 🔒 401 — no token
PATCH {{host}}/lists/{{createListNameOnly.response.body.id}}
Content-Type: application/json

{
  "name": "Should Fail"
}


# ══════════════════════════════════════════
#  DELETE /lists/:id
# ══════════════════════════════════════════

### ❌ 400 — invalid id
DELETE {{host}}/lists/not-a-uuid
Authorization: Bearer {{token}}

###

### ❌ 404 — does not exist
DELETE {{host}}/lists/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

###

### 🔒 401 — no token
DELETE {{host}}/lists/{{createListNameOnly.response.body.id}}

###

### ✅ 204 — archive createListNameOnly (renamed above to "Weekend Hiking (renamed)")
DELETE {{host}}/lists/{{createListNameOnly.response.body.id}}
Authorization: Bearer {{token}}

###

### ✅ 204 — idempotent: archiving it again still succeeds, not an error
DELETE {{host}}/lists/{{createListNameOnly.response.body.id}}
Authorization: Bearer {{token}}

###

### ✅ 200 — GET /lists?archived=true now includes it, GET /lists no longer does
GET {{host}}/lists?archived=true
Authorization: Bearer {{token}}

###

### ✅ 200 — GET /lists/:id still returns full detail for the archived list
GET {{host}}/lists/{{createListNameOnly.response.body.id}}
Authorization: Bearer {{token}}


# ══════════════════════════════════════════
#  Cleanup
# ══════════════════════════════════════════
#
#  DELETE /lists/:id now exists (PACK-011), but it only archives — there's no
#  hard-delete, so lists created in this file stay in the DB (archived).
#  Archive the remaining two lists here so ItemIsInUse (which only counts
#  non-archived list references) stops blocking the item/category deletes
#  below — createListFromTemplate is the one that actually references
#  createItem via packing_list_items.

### 204 — archive createListWithEventDate
DELETE {{host}}/lists/{{createListWithEventDate.response.body.id}}
Authorization: Bearer {{token}}

###

### 204 — archive createListFromTemplate
DELETE {{host}}/lists/{{createListFromTemplate.response.body.id}}
Authorization: Bearer {{token}}

###

### 204 — remove the item from the template (clears the template_items reference)
DELETE {{host}}/templates/{{createTemplate.response.body.id}}/items/{{createItem.response.body.id}}
Authorization: Bearer {{token}}

###

### 204 — delete the template
DELETE {{host}}/templates/{{createTemplate.response.body.id}}
Authorization: Bearer {{token}}

###

### ✅ 204 — item can now be deleted: its only list reference (createListFromTemplate)
#          is archived, and archived lists don't count for ItemIsInUse
DELETE {{host}}/items/{{createItem.response.body.id}}
Authorization: Bearer {{token}}

###

### ✅ 204 — category can now be deleted too
DELETE {{host}}/categories/{{createCategory.response.body.id}}
Authorization: Bearer {{token}}
