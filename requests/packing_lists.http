Authorization: Bearer {{$dotenv DEV_TOKEN}}


# ══════════════════════════════════════════
#  Cleanup
# ══════════════════════════════════════════
#
#  DELETE /lists/:id only archives — there's no hard-delete, so lists
#  created in this file stay in the DB (archived). Archive the two
#  remaining active lists here so ItemIsInUse (which only counts
#  non-archived list references) stops blocking the item/category deletes
#  below — both createListFromTemplate (seeded from the template) and
#  createListWithEventDate (carries createItem and createItemTwo from the
#  sections above) reference items via packing_list_items, so both need
#  archiving before it's free to delete them.

### 204 — archive createListWithEventDate
DELETE http://localhost:{{$dotenv PORT}}/lists/{{createListWithEventDate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 204 — archive createListFromTemplate
DELETE http://localhost:{{$dotenv PORT}}/lists/{{createListFromTemplate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 204 — remove the item from the template (clears the template_items reference)
DELETE http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/{{createItem.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 204 — delete the template
DELETE http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ✅ 204 — item can now be deleted: its list references are all archived,
#          and archived lists don't count for ItemIsInUse
DELETE http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ✅ 204 — same for the second item
DELETE http://localhost:{{$dotenv PORT}}/items/{{createItemTwo.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ✅ 204 — category can now be deleted too
DELETE http://localhost:{{$dotenv PORT}}/categories/{{createCategory.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}
