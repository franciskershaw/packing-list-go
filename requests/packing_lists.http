# ══════════════════════════════════════════
#  PATCH /lists/:id/items/:itemId
# ══════════════════════════════════════════
#
#  👉 NEW IN THIS COMMIT — self-contained: run just this section (its own
#  setup and cleanup below), no earlier sections needed. Per the PACK-012
#  retro, sections from here on don't reach back into Setup/earlier
#  sections' captured variables.

### setup — a category for this section's item
# @name patchItemSetupCategory
POST {{host}}/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Patch Item Test — Category {{$guid}}"
}

###

### setup — an item in that category
# @name patchItemSetupItem
POST {{host}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Patch Item Test — Item {{$guid}}",
  "categoryId": "{{patchItemSetupCategory.response.body.id}}"
}

###

### setup — a list to attach it to
# @name patchItemSetupList
POST {{host}}/lists
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Patch Item Test — List {{$guid}}"
}

###

### setup — attach the item to the list
POST {{host}}/lists/{{patchItemSetupList.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemId": "{{patchItemSetupItem.response.body.id}}",
  "quantity": 1
}

###

### ✅ 200 — quantity only
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 5
}

###

### ✅ 200 — notes only
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "notes": "bring extra"
}

###

### ✅ 200 — sortOrder only, negative accepted
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "sortOrder": -2
}

###

### ❌ 400 — none of quantity/notes/sortOrder present
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{}

###

### ❌ 404 — item not on this list
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 2
}

###

### ❌ 404 — list does not exist
PATCH {{host}}/lists/00000000-0000-0000-0000-000000000000/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 2
}

###

### ❌ 400 — invalid itemId
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/not-a-uuid
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 2
}

###

### ❌ 400 — invalid list id
PATCH {{host}}/lists/not-a-uuid/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 2
}

###

### 🔒 401 — no token
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json

{
  "quantity": 2
}

###

### ✅ 200 — isPacked only (PACK-013)
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isPacked": true
}

###

### ✅ 200 — isPacked explicit false is distinguishable from omission (PACK-013)
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isPacked": false
}

###

### ✅ 200 — quantity + isPacked combined (PACK-013)
PATCH {{host}}/lists/{{patchItemSetupList.response.body.id}}/items/{{patchItemSetupItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 6,
  "isPacked": true
}

###

### cleanup — archive this section's list (its own, unlike the shared
#            Cleanup section below — nothing else depends on it)
DELETE {{host}}/lists/{{patchItemSetupList.response.body.id}}
Authorization: Bearer {{token}}

###

### cleanup — delete this section's item
DELETE {{host}}/items/{{patchItemSetupItem.response.body.id}}
Authorization: Bearer {{token}}

###

### cleanup — delete this section's category
DELETE {{host}}/categories/{{patchItemSetupCategory.response.body.id}}
Authorization: Bearer {{token}}


