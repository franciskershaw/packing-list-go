# Packing List API — Template Item Endpoints
#
# SETUP (do this once before running any request):
#
#   1. Start the server:  go run main.go
#   2. Generate a token:  go run scripts/gen_token.go
#
# Token and host resolve automatically from .env — see requests/README.md
# for how that works. No variables to paste in this file.
#
# Recommended order: run the requests top-to-bottom.
# This file duplicates its own template + item + category setup (mirroring
# how items.http duplicates category setup rather than depending on
# categories.http) — send the setup section first, then everything else
# references the captured IDs.


# ══════════════════════════════════════════
#  Setup — a template, a category, and two items to attach to it
# ══════════════════════════════════════════

### create the template items will be attached to
# @name createTemplate
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Template Items Test"
}

###

### create the category items will be created under
# @name createCategory
POST http://localhost:{{$dotenv PORT}}/categories
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Template Items Test — Category"
}

###

### create the first item — this is the one exercised by the single-item endpoints below
# @name createItem
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Template Items Test — Item One",
  "categoryId": "{{createCategory.response.body.id}}"
}

###

### create a second item in the same category — used by the bulk-add tests
# @name createItemTwo
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Template Items Test — Item Two",
  "categoryId": "{{createCategory.response.body.id}}"
}


# ══════════════════════════════════════════
#  POST /templates/:id/items
# ══════════════════════════════════════════

### ✅ 201 — attaches the item with an explicit quantity and notes
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "{{createItem.response.body.id}}",
  "quantity": 3,
  "notes": "pack the waterproof ones"
}

###

### ❌ 409 — item is already on the template (requires the 201 above)
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "{{createItem.response.body.id}}"
}

###

### ❌ 400 — missing itemId
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{}

###

### ❌ 400 — invalid itemId (not a UUID)
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "not-a-uuid"
}

###

### ❌ 400 — itemId does not exist / not accessible
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "00000000-0000-0000-0000-000000000000"
}

###

### ❌ 400 — quantity out of range (too low)
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "{{createItemTwo.response.body.id}}",
  "quantity": 0
}

###

### ❌ 400 — quantity out of range (too high)
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "{{createItemTwo.response.body.id}}",
  "quantity": 1000
}

###

### ❌ 400 — notes exceed 200 characters
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "{{createItemTwo.response.body.id}}",
  "notes": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX"
}

###

### ❌ 404 — template does not exist
POST http://localhost:{{$dotenv PORT}}/templates/00000000-0000-0000-0000-000000000000/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "itemId": "{{createItemTwo.response.body.id}}"
}

###

### 🔒 401 — no token
POST http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items
Content-Type: application/json

{
  "itemId": "{{createItemTwo.response.body.id}}"
}


# ══════════════════════════════════════════
#  PATCH /templates/:id/items/:itemId
#
#  Uses the item attached by the first POST above.
# ══════════════════════════════════════════

### ✅ 200 — updates quantity only
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "quantity": 5
}

###

### ✅ 200 — updates notes only
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "notes": "actually pack the blue ones"
}

###

### ✅ 200 — notes: "" clears it to an empty string (not null)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "notes": ""
}

###

### ❌ 400 — neither quantity nor notes provided
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{}

###

### ❌ 400 — quantity out of range
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "quantity": 1000
}

###

### ❌ 404 — template does not exist
PATCH http://localhost:{{$dotenv PORT}}/templates/00000000-0000-0000-0000-000000000000/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "quantity": 2
}

###

### ❌ 404 — item is not on this template
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/{{createItemTwo.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "quantity": 2
}

###

### ❌ 400 — invalid itemId (not a UUID)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/not-a-uuid
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "quantity": 2
}


# ══════════════════════════════════════════
#  PATCH /templates/:id/items/bulk (PACK-035)
#
#  Delta contract: quantity 0 removes (no-op if already absent), any other
#  quantity in [0, 999] adds the item if absent or updates it if present.
#  createItem is already attached (quantity 5 after the PATCH section
#  above); createItemTwo is not yet attached — this section adds it back
#  alongside updating createItem, in one request, so both are attached by
#  the time the GET below checks the detail view.
# ══════════════════════════════════════════

### ✅ 204 — mixed batch: update createItem's quantity, add createItemTwo
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [
    { "itemId": "{{createItem.response.body.id}}", "quantity": 6 },
    { "itemId": "{{createItemTwo.response.body.id}}", "quantity": 2 }
  ]
}

###

### ✅ 204 — running the same batch again is safe (both already at these
#          quantities — updates to the same value, not an error)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [
    { "itemId": "{{createItem.response.body.id}}", "quantity": 6 },
    { "itemId": "{{createItemTwo.response.body.id}}", "quantity": 2 }
  ]
}

###

### ❌ 400 — empty items array
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": []
}

###

### ❌ 400 — duplicate itemId in the same request
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [
    { "itemId": "{{createItem.response.body.id}}", "quantity": 1 },
    { "itemId": "{{createItem.response.body.id}}", "quantity": 2 }
  ]
}

###

### ❌ 400 — invalid itemId (not a UUID)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [{ "itemId": "not-a-uuid", "quantity": 1 }]
}

###

### ❌ 400 — quantity below the allowed range (negative)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [{ "itemId": "{{createItem.response.body.id}}", "quantity": -1 }]
}

###

### ❌ 400 — quantity above the allowed range (> 999)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [{ "itemId": "{{createItem.response.body.id}}", "quantity": 1000 }]
}

###

### ❌ 400 — itemId does not exist / not accessible
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [{ "itemId": "00000000-0000-0000-0000-000000000000", "quantity": 1 }]
}

###

### ❌ 404 — template does not exist
PATCH http://localhost:{{$dotenv PORT}}/templates/00000000-0000-0000-0000-000000000000/items/bulk
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "items": [{ "itemId": "{{createItem.response.body.id}}", "quantity": 1 }]
}


# ══════════════════════════════════════════
#  GET /templates/:id — confirm attached items show up on the detail view
# ══════════════════════════════════════════

### ✅ 200 — both items now appear in the items array (no duplication)
GET http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}


# ══════════════════════════════════════════
#  PATCH /templates/:id — confirm items survive a template-level update
#  (regression check: UpdateTemplate used to always return items: [], even
#  when the template had real items attached, because it never re-fetched
#  them after the UPDATE — fixed to match GetTemplateByID's behavior)
# ══════════════════════════════════════════

### ✅ 200 — renames the template; both items must still be present in the response
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Template Items Test — Renamed"
}

###

### ✅ 200 — GET confirms the rename didn't drop the items either
GET http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}


