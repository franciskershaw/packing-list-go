# Packing List API — Item Endpoints
#
# SETUP (do this once before running any request):
#
#   1. Start the server:  go run main.go
#   2. Generate a token:  go run scripts/gen_token.go
#
# Token and host resolve automatically from .env — see requests/README.md
# for how that works. No variables to paste in this file.
#
# Recommended order: run the requests top-to-bottom.
# Items live under categories, so the first two POSTs create a "home" category
# and a "target" category (used for the move-category tests) — send those
# first, then everything else references their captured IDs.


# ══════════════════════════════════════════
#  Setup — categories to hang items off
# ══════════════════════════════════════════

### create the category items will be created under
# @name createHomeCategory
POST http://localhost:{{$dotenv PORT}}/categories
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Items Test — Home Category"
}

###

### create a second category, used for the "move to another category" PATCH tests
# @name createTargetCategory
POST http://localhost:{{$dotenv PORT}}/categories
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Items Test — Target Category"
}


# ══════════════════════════════════════════
#  GET /items
# ══════════════════════════════════════════

### ✅ 200 — returns system + own items as a flat list
GET http://localhost:{{$dotenv PORT}}/items
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ✅ 200 — filter by category_id
GET http://localhost:{{$dotenv PORT}}/items?category_id={{createHomeCategory.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ✅ 200 — filter by search (case-insensitive partial match)
GET http://localhost:{{$dotenv PORT}}/items?search=test item
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ✅ 200 — both filters combined
GET http://localhost:{{$dotenv PORT}}/items?category_id={{createHomeCategory.response.body.id}}&search=test item
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 400 — invalid category_id (not a UUID)
GET http://localhost:{{$dotenv PORT}}/items?category_id=not-a-uuid
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 400 — category_id does not exist / not accessible
GET http://localhost:{{$dotenv PORT}}/items?category_id=00000000-0000-0000-0000-000000000000
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 🔒 401 — no token
GET http://localhost:{{$dotenv PORT}}/items


# ══════════════════════════════════════════
#  POST /items
# ══════════════════════════════════════════

### ✅ 201 — creates a new user-owned item under the home category
# @name createItem
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Test Item",
  "categoryId": "{{createHomeCategory.response.body.id}}"
}

###

### ❌ 400 — missing name
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "categoryId": "{{createHomeCategory.response.body.id}}"
}

###

### ❌ 400 — empty name
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "",
  "categoryId": "{{createHomeCategory.response.body.id}}"
}

###

### ❌ 400 — name exceeds 100 characters
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX",
  "categoryId": "{{createHomeCategory.response.body.id}}"
}

###

### ❌ 400 — missing categoryId
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "No Category Item"
}

###

### ❌ 400 — invalid categoryId (not a UUID)
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Bad Category Item",
  "categoryId": "not-a-uuid"
}

###

### ❌ 400 — categoryId does not exist / not accessible
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Inaccessible Category Item",
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

###

### ❌ 409 — duplicate name in the same category (requires the 201 above to have been sent first)
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Test Item",
  "categoryId": "{{createHomeCategory.response.body.id}}"
}

###

### ✅ 201 — same name is fine in a different category
# @name createItemInTargetCategory
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Test Item",
  "categoryId": "{{createTargetCategory.response.body.id}}"
}

###

### ✅ 201 — creating a user item under a system category is allowed
#          (requires seed data: psql $DATABASE_URL -f db/seeds/categories.sql)
#          replace the categoryId below with a real system category ID from your DB
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Toothbrush Cover",
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

###

### 🔒 401 — no token
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json

{
  "name": "Should Fail",
  "categoryId": "{{createHomeCategory.response.body.id}}"
}


# ══════════════════════════════════════════
#  PATCH /items/:id
#
#  The happy-path requests below use the ID captured from the "createItem"
#  POST above. Send that request first, then run these.
# ══════════════════════════════════════════

### ✅ 200 — renames the created item
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Renamed Test Item"
}

###

### ✅ 200 — moves the item to the target category
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "categoryId": "{{createTargetCategory.response.body.id}}"
}

###

### ✅ 200 — updates name and category together
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Renamed Again",
  "categoryId": "{{createHomeCategory.response.body.id}}"
}

###

### ❌ 400 — no fields provided
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{}

###

### ❌ 400 — empty name
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": ""
}

###

### ❌ 400 — name too long
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX"
}

###

### ❌ 400 — invalid categoryId (not a UUID)
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "categoryId": "not-a-uuid"
}

###

### ❌ 400 — categoryId does not exist / not accessible
PATCH http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

###

### ❌ 409 — duplicate name in the target category
# @name createDuplicateCandidate
POST http://localhost:{{$dotenv PORT}}/items
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Duplicate Candidate",
  "categoryId": "{{createHomeCategory.response.body.id}}"
}

###

### ❌ 409 — rename to a name already used by another item in the same category
#          (requires the createDuplicateCandidate POST above to have been sent
#          first in this session, so its id is resolved)
PATCH http://localhost:{{$dotenv PORT}}/items/{{createDuplicateCandidate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Renamed Again"
}

###

### ❌ 404 — item does not exist
PATCH http://localhost:{{$dotenv PORT}}/items/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Anything"
}


# ══════════════════════════════════════════
#  DELETE /items/:id
#
#  Send the createItem POST first (or createDuplicateCandidate) to get an ID
#  to delete. After the 204 below the item is gone — subsequent PATCH/DELETE
#  requests against the same ID will return 404.
#
#  409 (item in use on a template or active packing list) isn't exercised
#  here, or anywhere else in this suite — template_items.http and
#  packing_lists.http both detach items before deleting them in their own
#  cleanup specifically to avoid it. Not covered anywhere currently.
# ══════════════════════════════════════════

### ✅ 204 — deletes the duplicate-candidate item (no response body)
DELETE http://localhost:{{$dotenv PORT}}/items/{{createDuplicateCandidate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 404 — already deleted (or never existed)
DELETE http://localhost:{{$dotenv PORT}}/items/{{createDuplicateCandidate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 404 — non-existent UUID
DELETE http://localhost:{{$dotenv PORT}}/items/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{$dotenv DEV_TOKEN}}


# ══════════════════════════════════════════
#  Cleanup — categories can't be deleted while they still have items
#  (DELETE /categories/:id returns 409 if CategoryHasItems), so remove the
#  remaining items first, then the two test categories.
#
#  If you customised the "creating a user item under a system category"
#  request above with a real system category ID, delete that item manually
#  too before moving on — it isn't tracked here.
# ══════════════════════════════════════════

### 204 — delete the item left in the home category
DELETE http://localhost:{{$dotenv PORT}}/items/{{createItem.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 204 — delete the item left in the target category
DELETE http://localhost:{{$dotenv PORT}}/items/{{createItemInTargetCategory.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 204 — delete home category
DELETE http://localhost:{{$dotenv PORT}}/categories/{{createHomeCategory.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 204 — delete target category
DELETE http://localhost:{{$dotenv PORT}}/categories/{{createTargetCategory.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}
