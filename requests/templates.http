# Packing List API — Template Endpoints
#
# SETUP (do this once before running any request):
#
#   1. Start the server:  go run main.go
#   2. Generate a token:  go run scripts/gen_token.go
#
# Token and host resolve automatically from .env — see requests/README.md
# for how that works. No variables to paste in this file.
#
# Recommended order: run the requests top-to-bottom.
# Templates have no system-level concept (every template is user-owned), so
# unlike categories.http/items.http there's no "system row" setup step.


# ══════════════════════════════════════════
#  GET /templates
# ══════════════════════════════════════════

### ✅ 200 — empty list before any templates exist
GET http://localhost:{{$dotenv PORT}}/templates
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### 🔒 401 — no token
GET http://localhost:{{$dotenv PORT}}/templates


# ══════════════════════════════════════════
#  POST /templates
# ══════════════════════════════════════════

### ✅ 201 — creates a template with name only (items: [])
# @name createTemplate
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Weekend Hiking"
}

###

### ✅ 201 — creates a template with name and description
# @name createTemplateWithDescription
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Beach Trip",
  "description": "Sun, sand, and sunscreen"
}

###

### ❌ 400 — missing name
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "description": "No name here"
}

###

### ❌ 400 — empty name
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": ""
}

###

### ❌ 400 — name exceeds 100 characters
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX"
}

###

### ❌ 400 — description exceeds 500 characters
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Too Much Detail",
  "description": ""
}

###

### ❌ 409 — duplicate name (requires the "Weekend Hiking" POST above)
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Weekend Hiking"
}

###

### 🔒 401 — no token
POST http://localhost:{{$dotenv PORT}}/templates
Content-Type: application/json

{
  "name": "Should Fail"
}


# ══════════════════════════════════════════
#  GET /templates/:id
#
#  Requires the createTemplate POST above to have been sent first.
# ══════════════════════════════════════════

### ✅ 200 — returns the template with items: []
GET http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 400 — invalid id (not a UUID)
GET http://localhost:{{$dotenv PORT}}/templates/not-a-uuid
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 404 — template does not exist
GET http://localhost:{{$dotenv PORT}}/templates/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{$dotenv DEV_TOKEN}}


# ══════════════════════════════════════════
#  PATCH /templates/:id
#
#  Requires the createTemplate POST above to have been sent first.
# ══════════════════════════════════════════

### ✅ 200 — renames the template
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Weekend Hiking (Renamed)"
}

###

### ✅ 200 — updates description only, name unchanged
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "description": "Now with a description"
}

###

### ✅ 200 — description: "" clears it to an empty string (not null)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "description": ""
}

###

### ❌ 400 — neither name nor description provided
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{}

###

### ❌ 400 — name too long
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaX"
}

###

### ❌ 409 — rename to a name already used by another of the caller's templates
#          (requires the createTemplateWithDescription POST above to have
#          been sent first, so "Beach Trip" exists)
PATCH http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Beach Trip"
}

###

### ❌ 404 — template does not exist
PATCH http://localhost:{{$dotenv PORT}}/templates/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{$dotenv DEV_TOKEN}}

{
  "name": "Anything"
}


# ══════════════════════════════════════════
#  DELETE /templates/:id
#
#  409-if-in-use does NOT apply to templates (unlike categories/items) —
#  deletion is unconditional even if a packing list references this
#  template (packing_lists.template_id is set to NULL, not blocked). See
#  packing_lists.http's Setup section, which creates a list from a template
#  and then deletes that template in its own cleanup without a 409.
# ══════════════════════════════════════════

### ✅ 204 — deletes the template (no response body)
DELETE http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 404 — already deleted (or never existed)
DELETE http://localhost:{{$dotenv PORT}}/templates/{{createTemplate.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}

###

### ❌ 400 — invalid id (not a UUID)
DELETE http://localhost:{{$dotenv PORT}}/templates/not-a-uuid
Authorization: Bearer {{$dotenv DEV_TOKEN}}


# ══════════════════════════════════════════
#  Cleanup
# ══════════════════════════════════════════

### 204 — delete the remaining "Beach Trip" template
DELETE http://localhost:{{$dotenv PORT}}/templates/{{createTemplateWithDescription.response.body.id}}
Authorization: Bearer {{$dotenv DEV_TOKEN}}
